---
import { ruta } from "../lib/url";

interface Props {
  kicker: string;
  titulo: string;
  destacado?: string;
  bajada?: string;
  imagen?: string;
}
const { kicker, titulo, destacado, bajada, imagen } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-steel-950 text-white">
  {
    imagen && (
      <div class="absolute inset-0 -z-10">
        <img src={ruta(imagen)} alt="" aria-hidden="true" class="h-full w-full object-cover opacity-60" />
        <div class="absolute inset-0 bg-linear-to-r from-steel-950/95 via-steel-950/70 to-steel-950/25" />
      </div>
    )
  }
  <div class="grid-bg absolute inset-0 -z-10 opacity-30"></div>

  <div class="mx-auto max-w-7xl px-6 py-10 sm:py-12">
    <nav aria-label="Migas de pan" class="mb-3">
      <ol class="flex items-center gap-2 text-[12px] text-slate-500">
        <li><a href={ruta("/")} class="transition hover:text-slate-300">Inicio</a></li>
        <li aria-hidden="true" class="text-slate-700">/</li>
        <li class="text-slate-400">{kicker}</li>
      </ol>
    </nav>

    <h1 class="text-[30px] leading-[1.2] font-medium tracking-[0.01em] sm:text-[38px]">
      {titulo}{destacado && <> <span class="text-brand-500">{destacado}</span></>}
    </h1>

    {bajada && <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-slate-400">{bajada}</p>}
  </div>
</section>
