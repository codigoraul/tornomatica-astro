---
import Logo from "./Logo.astro";
import { site, nav, FUNDACION } from "../data/site";
import { ruta } from "../lib/url";

const anio = new Date().getFullYear();
---

<footer class="bg-steel-950 text-slate-400">
  <div class="mx-auto max-w-7xl px-6 py-16">
    <div class="grid gap-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <Logo variante="blanco" clase="h-12" />
        <p class="mt-4 max-w-md text-sm leading-relaxed">
          Fabricación de partes y piezas en serie en tornos automáticos de levas y torno CNC,
          en aceros, latón, aluminio y plásticos mecanizables.
        </p>
        <p class="mt-3 max-w-md text-sm leading-relaxed">
          Operamos desde {FUNDACION} en un galpón de {site.superficie} en Alto Jahuel, con
          instrumental metrológico que asegura la precisión dimensional de cada lote y personal
          técnico calificado.
        </p>
        <p class="mt-3 max-w-md text-sm leading-relaxed">
          Atendemos minería, agricultura, automotriz, línea blanca, agroindustria y manufactura
          en general.
        </p>
      </div>

      <nav class="md:col-span-3" aria-label="Pie de página">
        <h2 class="text-[11px] font-semibold tracking-[0.18em] text-slate-500 uppercase">Navegación</h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li><a href={ruta("/")} class="transition hover:text-white">Inicio</a></li>
          {nav.map((item) => (
            <li><a href={ruta(item.href)} class="transition hover:text-white">{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="md:col-span-4">
        <h2 class="text-[11px] font-semibold tracking-[0.18em] text-slate-500 uppercase">Contacto</h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li>
            <a href={site.telefonoHref} class="font-semibold text-white transition hover:text-brand-500">
              {site.telefono}
            </a>
          </li>
          <li>
            <a href={`mailto:${site.email}`} class="transition hover:text-white">{site.email}</a>
          </li>
          <li class="pt-1 leading-relaxed">{site.direccion}</li>
          <li>
            <a
              href={site.mapa}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-1.5 font-semibold text-brand-500 transition hover:text-brand-400"
            >
              Ver en el mapa
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path d="M7 17 17 7M9 7h8v8"></path>
              </svg>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-14 border-t border-white/10 pt-6 text-xs text-slate-500">
      © {anio} {site.nombre}. Todos los derechos reservados.
    </div>
  </div>
</footer>
