---
import { site } from "../data/site";
---

<section id="contacto" class="border-t border-slate-200 bg-slate-50 py-24">
  <div class="mx-auto grid max-w-7xl gap-16 px-6 lg:grid-cols-2">
    <div>
      <p class="text-xs font-bold tracking-[0.2em] text-brand-700 uppercase">Contacto</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
        Cuéntanos qué pieza necesitas
      </h2>
      <p class="mt-5 leading-relaxed text-slate-700">
        Envíanos el plano o una muestra e indícanos material y cantidad. Te respondemos con
        cotización y plazo.
      </p>

      <div class="mt-10 space-y-5 text-[15px]">
        <div>
          <p class="text-xs tracking-widest text-slate-500 uppercase">Dirección</p>
          <p class="font-semibold">{site.direccion}</p>
        </div>
        <div>
          <p class="text-xs tracking-widest text-slate-500 uppercase">Teléfono</p>
          <a href={site.telefonoHref} class="font-semibold hover:text-brand-600">{site.telefono}</a>
          {" / "}
          <a href={site.telefono2Href} class="font-semibold hover:text-brand-600">{site.telefono2}</a>
        </div>
        <div>
          <p class="text-xs tracking-widest text-slate-500 uppercase">Correo</p>
          <a href={`mailto:${site.email}`} class="font-semibold hover:text-brand-600">{site.email}</a>
        </div>
      </div>
    </div>

    <form id="formCotizacion" class="space-y-5 rounded-2xl border border-slate-200 bg-white p-8" novalidate>
      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="nombre" class="mb-1.5 block text-sm font-medium">Nombre</label>
          <input
            id="nombre"
            name="nombre"
            required
            class="w-full rounded-lg border border-slate-300 px-4 py-2.5 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/40 focus:outline-none"
          />
        </div>
        <div>
          <label for="empresa" class="mb-1.5 block text-sm font-medium">Empresa</label>
          <input
            id="empresa"
            name="empresa"
            class="w-full rounded-lg border border-slate-300 px-4 py-2.5 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/40 focus:outline-none"
          />
        </div>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="email" class="mb-1.5 block text-sm font-medium">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            class="w-full rounded-lg border border-slate-300 px-4 py-2.5 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/40 focus:outline-none"
          />
        </div>
        <div>
          <label for="telefono" class="mb-1.5 block text-sm font-medium">Teléfono</label>
          <input
            id="telefono"
            name="telefono"
            class="w-full rounded-lg border border-slate-300 px-4 py-2.5 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/40 focus:outline-none"
          />
        </div>
      </div>

      <div>
        <label for="mensaje" class="mb-1.5 block text-sm font-medium">Describe tu requerimiento</label>
        <textarea
          id="mensaje"
          name="mensaje"
          rows="4"
          required
          placeholder="Material, cantidad, medidas, plazo…"
          class="w-full rounded-lg border border-slate-300 px-4 py-2.5 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/40 focus:outline-none"></textarea>
      </div>

      <button
        type="submit"
        class="w-full rounded-lg bg-steel-950 px-6 py-3.5 font-semibold text-white transition hover:bg-steel-800"
      >
        Enviar solicitud
      </button>

      <p id="formEstado" class="hidden text-sm text-slate-700"></p>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById("formCotizacion") as HTMLFormElement | null;
  const estado = document.getElementById("formEstado");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    if (estado) {
      estado.classList.remove("hidden");
      estado.textContent =
        "Pendiente: conectar a un endpoint (Astro Actions, Formspree o el CF7 de WordPress).";
    }
  });
</script>
