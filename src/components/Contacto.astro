---
import { site } from "../data/site";

const rawBase = import.meta.env.BASE_URL ?? "/";
const basePath = rawBase === "/" ? "" : rawBase.replace(/\/$/, "");
const actionUrl = `${basePath}/contacto.php`;
---

<section id="contacto" class="border-t border-slate-200 bg-slate-50 py-24">
  <div class="mx-auto grid max-w-7xl gap-16 px-6 lg:grid-cols-2">
    <div>
      <p class="text-xs font-bold tracking-[0.2em] text-brand-700 uppercase">Contacto</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
        Cuéntanos qué pieza necesitas
      </h2>
      <p class="mt-5 leading-relaxed text-slate-700">
        Envíanos el plano o una muestra e indícanos material y cantidad. Te respondemos con
        cotización y plazo.
      </p>

      <div class="mt-10 space-y-5 text-[15px]">
        <div>
          <p class="text-xs tracking-widest text-slate-500 uppercase">Dirección</p>
          <p class="font-semibold">{site.direccion}</p>
        </div>
        <div>
          <p class="text-xs tracking-widest text-slate-500 uppercase">Teléfono</p>
          <a href={site.telefonoHref} class="font-semibold hover:text-brand-600">{site.telefono}</a>
          {" / "}
          <a href={site.telefono2Href} class="font-semibold hover:text-brand-600">{site.telefono2}</a>
        </div>
        <div>
          <p class="text-xs tracking-widest text-slate-500 uppercase">Correo</p>
          <a href={`mailto:${site.email}`} class="font-semibold hover:text-brand-600">{site.email}</a>
        </div>
      </div>
    </div>

    <form id="formCotizacion" class="form-light space-y-5 rounded-2xl border border-zinc-300 bg-[#EAEAEA] p-8 shadow-2xl shadow-zinc-400/30" action={actionUrl} method="POST" enctype="multipart/form-data" novalidate>
      <div class="flex items-center gap-3">
        <span class="h-px w-8 bg-brand-500"></span>
        <p class="text-xs font-bold tracking-[0.2em] uppercase" style="color: var(--color-brand-600)">Cotización rápida</p>
      </div>

      <input type="text" name="_gotcha" class="honeypot" tabindex="-1" autocomplete="off" />

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="nombre" class="mb-1.5 block text-sm font-semibold text-zinc-900">Nombre</label>
          <input
            id="nombre"
            name="nombre"
            required
            class="w-full rounded-lg border border-zinc-600 bg-zinc-800 px-4 py-2.5 text-white placeholder-zinc-500 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/40 focus:outline-none"
          />
        </div>
        <div>
          <label for="empresa" class="mb-1.5 block text-sm font-semibold text-zinc-900">Empresa</label>
          <input
            id="empresa"
            name="empresa"
            class="w-full rounded-lg border border-zinc-600 bg-zinc-800 px-4 py-2.5 text-white placeholder-zinc-500 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/40 focus:outline-none"
          />
        </div>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="email" class="mb-1.5 block text-sm font-semibold text-zinc-900">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            class="w-full rounded-lg border border-zinc-600 bg-zinc-800 px-4 py-2.5 text-white placeholder-zinc-500 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/40 focus:outline-none"
          />
        </div>
        <div>
          <label for="telefono" class="mb-1.5 block text-sm font-semibold text-zinc-900">Teléfono</label>
          <input
            id="telefono"
            name="telefono"
            class="w-full rounded-lg border border-zinc-600 bg-zinc-800 px-4 py-2.5 text-white placeholder-zinc-500 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/40 focus:outline-none"
          />
        </div>
      </div>

      <div>
        <label for="mensaje" class="mb-1.5 block text-sm font-semibold text-zinc-900">Describe tu requerimiento</label>
        <textarea
          id="mensaje"
          name="mensaje"
          rows="4"
          required
          placeholder="Material, cantidad, medidas, plazo…"
          class="w-full rounded-lg border border-zinc-600 bg-zinc-800 px-4 py-2.5 text-white placeholder-zinc-500 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/40 focus:outline-none"></textarea>
      </div>

      <div>
        <label for="adjunto" class="mb-1.5 block text-sm font-semibold text-zinc-900">Adjuntar plano, foto o croquis</label>
        <p class="mb-2 text-xs text-zinc-600">PDF, JPG, PNG o WEBP — máx. 10 MB.</p>
        <label for="adjunto" id="adjuntoLabel" class="flex cursor-pointer items-center justify-between gap-3 rounded-lg border border-dashed border-zinc-500 bg-zinc-800 px-4 py-3 text-sm text-zinc-300 transition hover:border-brand-500">
          <span id="adjuntoNombre">Seleccionar archivo…</span>
          <span class="shrink-0 rounded-md bg-zinc-700 px-3 py-1.5 text-xs font-semibold text-white">Elegir</span>
        </label>
        <input type="file" id="adjunto" name="adjunto" accept=".pdf,.jpg,.jpeg,.png,.webp,.heic,application/pdf,image/*" class="sr-only" />
      </div>

      <button
        type="submit"
        id="submitBtn"
        class="w-full rounded-lg bg-[#eeb420] px-6 py-3.5 font-semibold uppercase tracking-wide text-black transition hover:brightness-95"
      >
        <span>Enviar solicitud</span>
      </button>

      <p id="formEstado" class="hidden rounded-lg border p-4 text-sm"></p>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById("formCotizacion") as HTMLFormElement | null;
  const estado = document.getElementById("formEstado");
  const submitBtn = document.getElementById("submitBtn") as HTMLButtonElement | null;
  const adjuntoInput = document.getElementById("adjunto") as HTMLInputElement | null;
  const adjuntoNombre = document.getElementById("adjuntoNombre");
  const MAX_FILE_BYTES = 10 * 1024 * 1024;

  adjuntoInput?.addEventListener("change", () => {
    const file = adjuntoInput.files?.[0];
    if (!adjuntoNombre) return;

    if (!file) {
      adjuntoNombre.textContent = "Seleccionar archivo…";
      return;
    }

    if (file.size > MAX_FILE_BYTES) {
      adjuntoNombre.textContent = "Archivo muy grande (máx. 10 MB)";
      adjuntoInput.value = "";
      return;
    }

    adjuntoNombre.textContent = file.name;
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = "Enviando…";
    }

    try {
      const formData = new FormData(form);
      const response = await fetch(form.action, { method: "POST", body: formData });
      const result = await response.json();

      if (estado) {
        estado.classList.remove("hidden", "bg-red-500/10", "text-red-700", "border-red-500/40", "bg-brand-500/15", "text-brand-700", "border-brand-500/40");
        estado.textContent = result.message;

        if (result.success) {
          estado.classList.add("bg-brand-500/15", "text-brand-700", "border-brand-500/40");
          form.reset();
          if (adjuntoNombre) adjuntoNombre.textContent = "Seleccionar archivo…";
        } else {
          estado.classList.add("bg-red-500/10", "text-red-700", "border-red-500/40");
        }

        estado.scrollIntoView({ behavior: "smooth", block: "center" });
      }
    } catch (err) {
      if (estado) {
        estado.classList.remove("hidden", "bg-brand-500/15", "text-brand-700", "border-brand-500/40");
        estado.classList.add("bg-red-500/10", "text-red-700", "border-red-500/40");
        estado.textContent = "Error de conexión. Por favor intenta nuevamente.";
        estado.scrollIntoView({ behavior: "smooth", block: "center" });
      }
    }

    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.textContent = "Enviar solicitud";
    }
  });
</script>

<style>
  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  #submitBtn:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

</style>
