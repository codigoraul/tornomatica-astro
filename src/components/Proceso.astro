---
import { proceso } from "../data/site";
import { ruta } from "../lib/url";
---

<section id="proceso" class="py-24">
  <div class="mx-auto max-w-7xl px-6">
    <div class="grid items-start gap-16 lg:grid-cols-2">
      <div>
        <p class="text-xs font-bold tracking-[0.2em] text-brand-700 uppercase">Proceso productivo</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
          De tu plano a la pieza terminada
        </h2>
        <p class="mt-5 leading-relaxed text-slate-700">
          Un flujo claro en cuatro etapas, con validación tuya en cada punto crítico.
        </p>
        <a
          href={ruta("/proceso-productivo")}
          class="mt-8 inline-block rounded-lg bg-steel-950 px-6 py-3 font-semibold text-white transition hover:bg-steel-800"
        >
          Ver el proceso completo
        </a>
      </div>

      <ol class="space-y-8 border-l-2 border-slate-200 pl-8">
        {
          proceso.map((p, i) => (
            <li class="relative">
              <span
                class:list={[
                  "absolute -left-[41px] top-0 h-5 w-5 rounded-full ring-4 ring-white",
                  i === 0 ? "bg-brand-500" : "bg-slate-300",
                ]}
              />
              <h3 class="font-bold">
                {p.n} · {p.titulo}
              </h3>
              <p class="mt-1.5 text-[15px] text-slate-700">{p.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
