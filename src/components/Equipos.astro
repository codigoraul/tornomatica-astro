---
import { equipos } from "../data/site";
import { ruta } from "../lib/url";
---

<section id="equipos" class="bg-steel-950 py-24 text-white">
  <div class="mx-auto max-w-7xl px-6">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="text-xs font-bold tracking-[0.2em] text-brand-500 uppercase">Equipamiento</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
          Con qué fabricamos
        </h2>
      </div>
      <a href={ruta("/productos")} class="text-sm font-semibold text-brand-500 hover:text-brand-400">
        Ver equipos, piezas y planos →
      </a>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-2">
      {
        equipos.map((p) => (
          <article class="group overflow-hidden rounded-2xl border border-steel-700 bg-steel-900 transition hover:border-brand-500/40">
            <div class="aspect-16/10 overflow-hidden bg-steel-800">
              <img
                src={ruta(p.img)}
                alt={p.titulo}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
              />
            </div>
            <div class="p-7">
              <h3 class="text-xl font-bold">{p.titulo}</h3>
              <p class="mt-3 text-[15px] leading-relaxed text-slate-400">{p.texto}</p>
              <div class="mt-5 flex flex-wrap gap-2 text-[11px] font-medium">
                {p.tags.map((t) => (
                  <span class="rounded-full border border-slate-700 bg-white/5 px-3 py-1">{t}</span>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
