---
import { getPiezas } from "../lib/piezas";
import { ruta } from "../lib/url";

interface Props {
  limite?: number;
}
const { limite = 6 } = Astro.props;

const { piezas } = await getPiezas();
const destacadas = piezas.slice(0, limite);
---

<section id="piezas" class="border-y border-slate-200 bg-slate-50 py-24">
  <div class="mx-auto max-w-7xl px-6">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <p class="text-xs font-bold tracking-[0.2em] text-brand-700 uppercase">Catálogo de productos</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">Piezas que fabricamos</h2>
        <p class="mt-5 leading-relaxed text-slate-700">
          Una muestra de nuestra producción. Cada pieza se fabrica según plano y especificación del
          cliente: estas son referencias, no un catálogo cerrado.
        </p>
      </div>
      <a href={ruta("/productos#piezas")} class="text-sm font-semibold text-brand-600 hover:text-brand-500">
        Ver todas las piezas →
      </a>
    </div>

    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        destacadas.map((p) => (
          <li class="group flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white transition hover:border-brand-500 hover:shadow-md">
            <a href={ruta(`/productos/${p.slug}`)} class="flex aspect-4/3 items-center justify-center overflow-hidden bg-slate-100">
              {p.imagen ? (
                <img
                  src={p.imagen}
                  alt={p.nombre}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                />
              ) : (
                <span class="flex flex-col items-center gap-2 text-slate-400">
                  <svg
                    class="h-10 w-10"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path d="M3 3h18v18H3z" />
                    <path d="M3 9h18M9 3v18" />
                    <circle cx="15.5" cy="14.5" r="2.5" />
                  </svg>
                  <span class="text-[11px] tracking-widest uppercase">Plano técnico</span>
                </span>
              )}
            </a>

            <div class="flex flex-1 flex-col p-6">
              <h3 class="text-[17px] leading-snug font-bold">
                <a href={ruta(`/productos/${p.slug}`)} class="transition hover:text-brand-600">
                  {p.nombre}
                </a>
              </h3>

              {p.codigo && <p class="mt-1 font-mono text-[12px] text-slate-500">{p.codigo}</p>}

              {(p.material || p.medida) && (
                <dl class="mt-4 space-y-1.5 text-[13px]">
                  {p.material && (
                    <div class="flex justify-between gap-3">
                      <dt class="text-slate-500">Material</dt>
                      <dd class="text-right font-medium text-slate-800">{p.material}</dd>
                    </div>
                  )}
                  {p.medida && (
                    <div class="flex justify-between gap-3">
                      <dt class="text-slate-500">Medida</dt>
                      <dd class="text-right font-medium text-slate-800">{p.medida}</dd>
                    </div>
                  )}
                </dl>
              )}

              <div class="mt-auto pt-5">
                {p.pdf ? (
                  <a
                    href={p.pdf}
                    target="_blank"
                    rel="noopener"
                    class="inline-flex items-center gap-2 text-sm font-semibold text-brand-600 transition hover:text-brand-500"
                  >
                    <svg
                      class="h-4 w-4"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                      <path d="M14 2v6h6M12 18v-6M9 15l3 3 3-3" />
                    </svg>
                    Ver plano (PDF)
                  </a>
                ) : (
                  <a
                    href={ruta("/contacto")}
                    class="inline-flex items-center gap-2 text-sm font-semibold text-slate-700 transition hover:text-brand-600"
                  >
                    Consultar por esta pieza
                    <svg
                      class="h-3.5 w-3.5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path d="M9 6l6 6-6 6" />
                    </svg>
                  </a>
                )}
              </div>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="mt-12 flex justify-center">
      <a
        href={ruta("/productos#piezas")}
        class="rounded-lg bg-steel-950 px-7 py-3.5 text-sm font-semibold text-white transition hover:bg-steel-800"
      >
        Ver todas las piezas y planos
      </a>
    </div>
  </div>
</section>
