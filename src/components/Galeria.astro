---
import { galeria } from "../data/site";
import { ruta } from "../lib/url";
---

<section id="galeria" class="py-24">
  <div class="mx-auto max-w-7xl px-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-xs font-bold tracking-[0.2em] text-brand-700 uppercase">Galería</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">Nuestro taller</h2>
      </div>
      <a href={ruta("/galeria")} class="text-sm font-semibold text-brand-600 hover:text-brand-500">
        Ver galería completa →
      </a>
    </div>

    <div class="mt-12 grid grid-cols-2 gap-4 lg:grid-cols-4">
      {
        galeria.slice(0, 4).map((g) => (
          <div class="aspect-square overflow-hidden rounded-xl bg-slate-100">
            <img
              src={g.src}
              alt={g.alt}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition duration-500 hover:scale-105"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>
