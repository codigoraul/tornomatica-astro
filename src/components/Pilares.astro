---
import { pilares } from "../data/site";
import { ruta } from "../lib/url";

const iconos: Record<string, string> = {
  target: '<path d="M12 2v4M12 18v4M2 12h4M18 12h4"/><circle cx="12" cy="12" r="5"/>',
  bolt: '<path d="M13 2 4 14h7l-1 8 9-12h-7z"/>',
  chart: '<path d="M4 20h16M6 16V8M12 16V4M18 16v-6"/>',
};
---

<section id="nosotros" class="border-y border-slate-200 bg-slate-50 py-24">
  <div class="mx-auto max-w-7xl px-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-2xl">
        <p class="text-xs font-bold tracking-[0.2em] text-brand-700 uppercase">Qué hacemos</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
          Mecanizado en serie, repetibilidad garantizada
        </h2>
      </div>
      <a href={ruta("/quienes-somos")} class="text-sm font-semibold text-brand-600 hover:text-brand-500">
        Conocer la empresa →
      </a>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {
        pilares.map((p) => (
          <article class="rounded-2xl border border-slate-200 bg-white p-8 transition hover:-translate-y-0.5 hover:shadow-lg">
            <div class="mb-5 flex h-11 w-11 items-center justify-center rounded-lg bg-steel-950 text-brand-500">
              <svg
                class="h-5 w-5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                aria-hidden="true"
                set:html={iconos[p.icono]}
              />
            </div>
            <h3 class="text-lg font-bold">{p.titulo}</h3>
            <p class="mt-3 text-[15px] leading-relaxed text-slate-700">{p.texto}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
