---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import CtaFinal from "../components/CtaFinal.astro";
import { site, sectores, fortalezas, galeria, FUNDACION } from "../data/site";

const anios = new Date().getFullYear() - FUNDACION;

const iconos: Record<string, string> = {
  building: '<path d="M4 21V5a1 1 0 0 1 1-1h9a1 1 0 0 1 1 1v16M15 10h4a1 1 0 0 1 1 1v10M3 21h18M8 8h3M8 12h3M8 16h3"/>',
  gauge: '<path d="M12 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM13.4 10.6 19 5M3.3 15a9 9 0 1 1 17.4 0"/>',
  users: '<circle cx="9" cy="8" r="4"/><path d="M2 21a7 7 0 0 1 14 0M17 5a4 4 0 0 1 0 6M19 21a7 7 0 0 0-3-5.7"/>',
};
---

<Layout
  titulo="Quiénes somos | Tornomatica"
  descripcion={`Tornomatica inició operaciones en ${FUNDACION}. Galpón de ${site.superficie} en Alto Jahuel, instrumental metrológico y personal técnico calificado para fabricar partes y piezas mecanizadas.`}
>
  <PageHero
    kicker="Quiénes somos"
    titulo={`${anios} años fabricando piezas`}
    destacado="con estándar de ingeniería"
    bajada={`Operando desde ${FUNDACION} en Alto Jahuel, Buin.`}
    imagen="/fondos/quienes-somos-bg.jpg"
  />

  <section class="py-24">
    <div class="mx-auto grid max-w-7xl gap-16 px-6 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="text-xs font-bold tracking-[0.2em] text-brand-700 uppercase">La empresa</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight">
          Partes y piezas mecanizadas con altos estándares de calidad
        </h2>

        <div class="mt-8 space-y-5 text-[17px] leading-relaxed text-slate-700">
          <p>
            Tornomatica es una empresa que inició sus operaciones en {FUNDACION}, motivada por la
            creciente necesidad del sector industrial de exigir servicios de ingeniería, fabricando
            partes y piezas mecanizadas con altos estándares de calidad y funcionalidad.
          </p>
          <p>
            Posee una infraestructura de un galpón de {site.superficie} ubicado en Alto Jahuel.
            Está equipado con buena tecnología en cuanto a maquinaria de procesos, como también de
            instrumental metrológico que asegura la precisión y calidad dimensional de sus
            productos, y cuenta con personal técnico altamente calificado.
          </p>
          <p>
            Atendemos a un universo bastante amplio de clientes que se desempeñan en todo el
            espectro de la industria.
          </p>
        </div>
      </div>

      <aside class="lg:col-span-5">
        <div class="overflow-hidden rounded-2xl border border-slate-200">
          <img src={galeria[1].src} alt="Taller Tornomatica en Alto Jahuel" loading="lazy" class="aspect-4/3 w-full object-cover" />
        </div>

        <dl class="mt-6 grid grid-cols-3 gap-4">
          <div class="rounded-xl bg-slate-50 p-4">
            <dt class="text-2xl font-extrabold">{FUNDACION}</dt>
            <dd class="mt-1 text-[11px] tracking-widest text-slate-500 uppercase">Fundación</dd>
          </div>
          <div class="rounded-xl bg-slate-50 p-4">
            <dt class="text-2xl font-extrabold">{site.superficie}</dt>
            <dd class="mt-1 text-[11px] tracking-widest text-slate-500 uppercase">Galpón</dd>
          </div>
          <div class="rounded-xl bg-slate-50 p-4">
            <dt class="text-2xl font-extrabold">+{anios}</dt>
            <dd class="mt-1 text-[11px] tracking-widest text-slate-500 uppercase">Años</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-slate-50 py-24">
    <div class="mx-auto max-w-7xl px-6">
      <p class="text-xs font-bold tracking-[0.2em] text-brand-700 uppercase">Nuestra capacidad</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight">Con qué respaldamos cada pedido</h2>

      <div class="mt-14 grid gap-6 md:grid-cols-3">
        {
          fortalezas.map((f) => (
            <article class="rounded-2xl border border-slate-200 bg-white p-8">
              <div class="mb-5 flex h-11 w-11 items-center justify-center rounded-lg bg-steel-950 text-brand-500">
                <svg
                  class="h-5 w-5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  set:html={iconos[f.icono]}
                />
              </div>
              <h3 class="text-lg font-bold">{f.titulo}</h3>
              <p class="mt-3 text-[15px] leading-relaxed text-slate-700">{f.texto}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-24">
    <div class="mx-auto max-w-7xl px-6">
      <div class="max-w-2xl">
        <p class="text-xs font-bold tracking-[0.2em] text-brand-700 uppercase">Clientes</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight">Industrias que atendemos</h2>
        <p class="mt-5 leading-relaxed text-slate-700">
          Nuestros clientes se desempeñan en todo el espectro de la industria nacional.
        </p>
      </div>

      <ul class="mt-12 flex flex-wrap gap-3">
        {
          sectores.map((s) => (
            <li class="rounded-full border border-slate-200 bg-slate-50 px-5 py-2.5 text-[15px] font-medium text-slate-700">
              {s}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaFinal />
</Layout>
